# 测试环境运行时变量, 供 deploy/docker-compose.yml 的 env_file 消费
#
# 只列必须由环境提供、或确需按环境覆盖的项, 其余取 Settings 代码默认值
# 取值一律为 shell 占位符, 真值由宿主机 source /etc/profile 注入
# 本文件不得出现任何真实凭据

ENV=${ENV:-test}
DEBUG=${DEBUG:-false}

# 无合适默认值时由环境提供, 缺失即启动失败或行为错误
DATABASE_URL=${DATABASE_URL}
REDIS_URL=${REDIS_URL}
JWT_SECRET_KEY=${JWT_SECRET_KEY}

# 按环境调整
CORS_ORIGINS=${CORS_ORIGINS:-}
LOG_LEVEL=${LOG_LEVEL:-INFO}
LOG_FORMAT=${LOG_FORMAT:-json}
{% if with_celery %}

CELERY_BROKER_URL=${CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${CELERY_RESULT_BACKEND}
{% endif %}
