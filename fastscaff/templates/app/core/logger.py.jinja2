import json
import logging
import sys
import traceback
from contextvars import ContextVar
from typing import Any, Dict, Optional

_EXTRA_FIELDS: ContextVar[Dict[str, Any]] = ContextVar("fastscaff_log_extra", default={})

_LEVEL_NAMES = {
    logging.DEBUG: "DEBUG",
    logging.INFO: "INFO",
    logging.WARNING: "WARN",
    logging.ERROR: "ERROR",
    logging.CRITICAL: "ERROR",
}


def format_error(exc: BaseException) -> str:
    return "".join(traceback.format_exception(type(exc), exc, exc.__traceback__))


class JsonFormatter(logging.Formatter):
    """Render LogRecord as a lean, collection-friendly JSON object."""

    def format(self, record: logging.LogRecord) -> str:
        entry: Dict[str, Any] = {
            "time": self.formatTime(record, "%Y-%m-%dT%H:%M:%S%z"),
            "level": _LEVEL_NAMES.get(record.levelno, record.levelname),
            "msg": record.getMessage(),
            "source": {
                "file": record.pathname,
                "line": record.lineno,
                "function": record.funcName,
            },
        }

        for key, value in _EXTRA_FIELDS.get().items():
            if value is not None and value != "":
                entry[key] = value

        fields = getattr(record, "extra_fields", None)
        if isinstance(fields, dict):
            for key, value in fields.items():
                if value is not None and value != "":
                    entry[key] = value

        if "error" not in entry and record.exc_info is not None:
            exc = record.exc_info[1]
            if isinstance(exc, BaseException):
                entry["error"] = format_error(exc)

        try:
            return json.dumps(entry, ensure_ascii=False, default=str)
        except (TypeError, ValueError):
            entry["msg"] = str(entry.get("msg", ""))
            return json.dumps(entry, ensure_ascii=False, default=str)


def setup_logging(*, log_level: str = "INFO", json_logs: bool = True) -> None:
    root_logger = logging.getLogger()
    root_logger.handlers.clear()

    handler = logging.StreamHandler(sys.stdout)
    if json_logs:
        handler.setFormatter(JsonFormatter())
    else:
        handler.setFormatter(
            logging.Formatter("%(asctime)s %(levelname)s %(name)s %(pathname)s:%(lineno)s %(message)s")
        )
    root_logger.addHandler(handler)
    root_logger.setLevel(log_level.upper())

    for logger_name in ["uvicorn", "uvicorn.error", "uvicorn.access"]:
        logging.getLogger(logger_name).handlers.clear()
        logging.getLogger(logger_name).propagate = True

    logging.getLogger("httpx").setLevel(logging.WARNING)
    logging.getLogger("httpcore").setLevel(logging.WARNING)


def bind_context(**kwargs: Any) -> None:
    merged = dict(_EXTRA_FIELDS.get())
    merged.update(kwargs)
    _EXTRA_FIELDS.set(merged)


def clear_context() -> None:
    _EXTRA_FIELDS.set({})


class StructuredLogger:
    """stdlib logger wrapper that accepts structured keyword fields."""

    def __init__(self, name: str) -> None:
        self._logger = logging.getLogger(name)

    def _log(
        self,
        level: int,
        msg: str,
        *,
        exc: Optional[BaseException] = None,
        stacklevel: int = 3,
        **fields: Any,
    ) -> None:
        payload = dict(fields)
        if exc is not None and "error" not in payload:
            payload["error"] = format_error(exc)
        self._logger.log(
            level,
            msg,
            extra={"extra_fields": payload},
            stacklevel=stacklevel,
        )

    def debug(self, msg: str, **fields: Any) -> None:
        self._log(logging.DEBUG, msg, **fields)

    def info(self, msg: str, **fields: Any) -> None:
        self._log(logging.INFO, msg, **fields)

    def warning(self, msg: str, **fields: Any) -> None:
        self._log(logging.WARNING, msg, **fields)

    def error(self, msg: str, **fields: Any) -> None:
        self._log(logging.ERROR, msg, **fields)


logger = StructuredLogger("{{ project_name_snake }}")
